<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 2. Redirect /files and /gallery_sync to public
    RewriteRule ^files/(.*)$ public/files/$1 [L]
    RewriteRule ^gallery_sync/(.*)$ public/gallery_sync/$1 [L]
    RewriteRule ^apk_versions/(.*)$ public/apk_versions/$1 [L]

    # 3. NEW: Redirect /build (Vite Assets) to public/build
    # This is what's causing your current error
    # RewriteCond %{REQUEST_URI} ^/build/(.*)$
    RewriteRule ^build/(.*)$ public/build/$1 [L]

    # 4. Handle everything else: Redirect all traffic to the public folder
    # This is better than pointing to root index.php for Laravel
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ public/$1 [L]

</IfModule>

# ... keep your PHP 8.2 handlers below ...

